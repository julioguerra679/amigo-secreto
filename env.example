# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y ajusta los valores.
#   cp .env.example .env
# NUNCA subas tu `.env` real a GitHub (ya está en .gitignore).
# ---------------------------------------------------------------------------

# --- Identidad del evento -------------------------------------------------
APP_NAME="Amigo Secreto 2026"
# URL pública de la app. Se usa para construir los links únicos que se
# entregan a cada participante. En local déjalo como está.
BASE_URL="http://127.0.0.1:8000"

# --- Seguridad ------------------------------------------------------------
# Clave para firmar la cookie de sesión del admin.
# Genérala con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="cambia-esto-por-una-clave-larga-y-aleatoria"

# Contraseña del panel de administración.
# OPCIÓN A (rápida, para local): contraseña en texto plano.
ADMIN_PASSWORD="admin123"
# OPCIÓN B (recomendada en producción): deja ADMIN_PASSWORD vacío y usa el hash.
#
# ⚠️ AQUÍ VA UN HASH, NO LA CONTRASEÑA. Genéralo con:
#      python -m app.security hash-password "tu-password"
# y pega el resultado completo, con sus símbolos '$':
#      pbkdf2_sha256$200000$3f1a…$9c4b…
# Si lo pegas cortado, nadie podrá entrar al panel.
ADMIN_PASSWORD_HASH=""

# Minutos de validez de la sesión del admin.
ADMIN_SESSION_MINUTES=120

# Anti fuerza bruta sobre el PIN de 4 dígitos.
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# --- Base de datos --------------------------------------------------------
# En local, SQLite es lo más cómodo: un archivo y nada que instalar.
DATABASE_URL="sqlite:///./data/amigo_secreto.db"
#
# En despliegues con sistema de archivos EFÍMERO (el plan gratuito de Render,
# por ejemplo) SQLite NO sirve: el archivo se borra en cada reinicio. Ahí usa
# PostgreSQL; la plataforma suele inyectar esta variable automáticamente:
# DATABASE_URL="postgresql://usuario:clave@host:5432/basedatos"
#
# No hace falta adaptar el formato a mano: la app reescribe `postgres://` y
# `postgresql://` al driver instalado (psycopg 3). Ver app/config.py.

# --- Correo (opcional) ----------------------------------------------------
# Si MAIL_ENABLED=false, la app no intenta enviar nada: el admin reparte los
# links manualmente desde el panel. Todo lo demás funciona igual.
MAIL_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Amigo Secreto <no-reply@example.com>"
SMTP_STARTTLS=true
SMTP_SSL=false
